# app.env.sample
# Copy to app.env and adjust values before starting the stack.
# These variables override the matching values in default.env for this app.
# No `export` prefix - this file is read by `docker compose --env-file`.

TZ=America/New_York
BASE_DOMAIN_NAME=example.com
BASE_HOST_NAME=borg.example.com

# Public URL used by generated backup commands.
BORG_APP_URL=https://borg.example.com

# Must be a non-root UID/GID and own the mounted directories.
APP_RUN_AS=1000

# Generate with: openssl rand -base64 32
APP_SECRET_KEY=replace-with-a-random-secret-key
APP_API_TOKEN=replace-with-a-random-32-char-key

# SMTP notifications (leave login and password empty for unauthenticated SMTP).
EMAIL_SERVER_PORT=587
EMAIL_SERVER_HOST=172.17.0.1
EMAIL_SERVER_MAIL_FROM=no-reply@borg.example.com
EMAIL_SERVER_LOGIN_NAME=
EMAIL_SERVER_LOGIN_PASS=
EMAIL_SERVER_REJECT_SELF_SIGNED=true

# Keep the SSH port visible in generated Borg commands unless a tunnel hides it.
HIDE_SSH_PORT=true
